[Unit]
Description=Artway-TM background synchronization for Allegro
Wants=network-online.target artway-backend.service
After=network-online.target artway-backend.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=artway
Group=artway
WorkingDirectory=/srv/artway/shop
Environment=NODE_ENV=production
Environment=ARTWAY_LOCAL_API_ORIGIN=http://127.0.0.1:3000
Environment=ARTWAY_ALLEGRO_WORKER_MS=900000
Environment=ARTWAY_ALLEGRO_WORKER_START_DELAY_MS=20000
EnvironmentFile=-/srv/artway/shop/.env.server
EnvironmentFile=-/srv/artway/ops/secrets/allegro.env
EnvironmentFile=/srv/artway/ops/secrets/session.env
ExecStart=/usr/bin/node /srv/artway/shop/scripts/run-allegro-sync-worker.mjs
Restart=always
RestartSec=10s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
