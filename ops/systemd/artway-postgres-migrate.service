[Unit]
Description=Artway-TM numerowane migracje PostgreSQL
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=artway-migrator
Group=artway-migrator
WorkingDirectory=/srv/artway/shop
Environment=NODE_ENV=production
Environment=DATABASE_URL=postgresql://artway_migrator@localhost/artway?host=/var/run/postgresql
Environment=ARTWAY_MIGRATION_ROLE=artway_migrator
Environment=ARTWAY_MIGRATION_OWNER_ROLE=artway_owner
ExecStart=/usr/bin/node /srv/artway/shop/scripts/migrate-postgres.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/srv/artway/shop
TimeoutStartSec=20min
