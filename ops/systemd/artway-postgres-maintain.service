[Unit]
Description=Artway-TM partycje, retencja i kontrola projekcji PostgreSQL
After=postgresql.service artway-backend.service

[Service]
Type=oneshot
User=artway-migrator
Group=artway-migrator
WorkingDirectory=/srv/artway/shop
Environment=NODE_ENV=production
Environment=DATABASE_URL=postgresql://artway_migrator@localhost/artway?host=/var/run/postgresql
Environment=ARTWAY_MIGRATION_ROLE=artway_migrator
Environment=ARTWAY_MIGRATION_OWNER_ROLE=artway_owner
ExecStart=/usr/bin/node /srv/artway/shop/scripts/maintain-postgres-partitions.mjs
ExecStart=/usr/bin/node /srv/artway/shop/scripts/verify-postgres-projections.mjs --strict
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/srv/artway/shop
TimeoutStartSec=10min
