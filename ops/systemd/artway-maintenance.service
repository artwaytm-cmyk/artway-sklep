[Unit]
Description=Artway safe server maintenance
Wants=postgresql.service
After=local-fs.target postgresql.service

[Service]
Type=oneshot
User=artway
Group=artway
WorkingDirectory=/srv/artway/shop
Environment=NODE_ENV=production
Environment=ARTWAY_STORE_DRIVER=postgres
Environment=DATABASE_URL=postgresql://artway_app@localhost/artway?host=/var/run/postgresql
ExecStart=/usr/bin/node /srv/artway/shop/scripts/run-server-maintenance.mjs
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/artway/releases /srv/artway/backups /srv/artway/ops /tmp
ReadOnlyPaths=/srv/artway/shop
TimeoutStartSec=15min
